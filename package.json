{
  "name": "@jackyzha0/quartz",
  "description": "🌱 publish your digital garden and notes as a website",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "author": "jackyzha0 <j.zhao2k19@gmail.com>",
  "license": "MIT",
  "homepage": "https://quartz.jzhao.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackyzha0/quartz.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "docs": "npx quartz build --serve -d docs",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "install-plugins": "npx quartz plugin install",
    "sync": "node scripts/sync-from-vault.mjs",
    "sync:soft": "node scripts/sync-from-vault.mjs --soft",
    "validate:home": "node scripts/validate-home-cards.mjs",
    "fix-paths": "node scripts/fix-excalidraw-paths.mjs",
    "inject-prev-next-related": "node scripts/build/inject-prev-next-related.mjs",
    "inject-engagement": "node scripts/build/inject-engagement.mjs",
    "inject-header-auth": "node scripts/build/inject-header-auth.mjs",
    "inject-account": "node scripts/build/inject-account.mjs",
    "inject-signin": "node scripts/build/inject-signin.mjs",
    "inject-analytics": "node scripts/build/inject-analytics.mjs",
    "inject-seo": "node scripts/build/inject-seo.mjs",
    "inject-security": "node scripts/build/inject-security.mjs",
    "inject-search-hint": "node scripts/build/inject-search-hint.mjs",
    "inject-status-badges": "node scripts/build/inject-status-badges.mjs",
    "inject-home-rail": "node scripts/build/inject-home-rail.mjs",
    "inject-home-personalize": "node scripts/build/inject-home-personalize.mjs",
    "inject-folder-pages": "node scripts/build/inject-folder-pages.mjs",
    "inject-404-suggestions": "node scripts/build/inject-404-suggestions.mjs",
    "remove-series-pages": "node scripts/build/remove-series-pages.mjs",
    "optimize-svgs": "node scripts/build/optimize-svgs.mjs",
    "emit-robots": "node scripts/build/emit-robots.mjs",
    "check-index-size": "node scripts/build/check-index-size.mjs",
    "trim-search-index": "node scripts/build/trim-search-index.mjs",
    "check-internal-links": "node scripts/build/check-internal-links.mjs",
    "validate:deploy-domain": "node scripts/build/validate-deploy-domain.mjs",
    "seo:audit": "node scripts/publish/seo-audit.mjs",
    "crosslinks:suggest": "node scripts/publish/suggest-crosslinks.mjs",
    "build": "npm run sync && npm run validate:home && npx quartz build && npm run fix-paths && npm run inject-prev-next-related && npm run inject-engagement && npm run inject-header-auth && npm run inject-account && npm run inject-signin && npm run inject-analytics && npm run inject-seo && npm run inject-security && npm run inject-search-hint && npm run inject-status-badges && npm run inject-home-rail && npm run inject-home-personalize && npm run inject-folder-pages && npm run inject-404-suggestions && npm run remove-series-pages && npm run optimize-svgs && npm run emit-robots && npm run trim-search-index && npm run check-index-size && npm run check-internal-links",
    "build:soft": "npm run sync:soft && npm run validate:home && npx quartz build && npm run fix-paths && npm run inject-prev-next-related && npm run inject-engagement && npm run inject-header-auth && npm run inject-account && npm run inject-signin && npm run inject-analytics && npm run inject-seo && npm run inject-security && npm run inject-search-hint && npm run inject-status-badges && npm run inject-home-rail && npm run inject-home-personalize && npm run inject-folder-pages && npm run inject-404-suggestions && npm run remove-series-pages && npm run optimize-svgs && npm run emit-robots && npm run trim-search-index && npm run check-index-size && npm run check-internal-links",
    "serve": "npm run sync && npm run validate:home && npx quartz build --serve",
    "serve:soft": "npm run sync:soft && npm run validate:home && npx quartz build --serve",
    "deploy": "npm run build && npm run validate:deploy-domain && gh-pages -d public -b gh-pages -m \"deploy: $(date -u +%FT%TZ)\" --nojekyll --dotfiles --remove \"**/*\""
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@floating-ui/dom": "^1.8.0",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@napi-rs/simple-git": "1.1.0",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "esbuild-sass-plugin": "^3.7.0",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.4",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "isomorphic-git": "^1.41.9",
    "lightningcss": "^1.33.0",
    "micromorph": "^0.4.5",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "pretty-bytes": "^7.1.1",
    "pretty-time": "^1.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rfdc": "^1.4.1",
    "serve-handler": "^6.1.7",
    "sharp": "^0.35.3",
    "source-map-support": "^0.5.21",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.3",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@quartz-community/types": "^0.2.1",
    "@quartz-community/utils": "^0.1.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.2.0",
    "@types/pretty-time": "^1.1.5",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.2",
    "excalidraw-to-svg": "^3.1.0",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "lz-string": "^1.5.0",
    "minimatch": "^10.2.6",
    "prettier": "^3.9.6",
    "svgo": "^4.0.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.3": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  }
}
